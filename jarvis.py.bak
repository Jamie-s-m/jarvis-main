#!/usr/bin/env python3
"""
Advanced Local AI Agent (Jarvis) - Auto-Package Installation Edition
"""

from __future__ import annotations

import ast
import contextlib
import io
import json
import logging
import os
import re
import subprocess
import sys
import threading
import time
import urllib.request
import webbrowser
from pathlib import Path

from dotenv import load_dotenv
import ollama

try:
    import pyttsx3
    HAS_TTS = True
except ImportError:
    HAS_TTS = False

try:
    import speech_recognition as sr
    HAS_STT = True
except ImportError:
    HAS_STT = False

# --- Configuration & Paths ---------------------------------------------------
OLLAMA_MODEL = "llama3.1"
WAKE_WORD = "jarvis"
STT_LANGUAGE = "en-US"
MEMORY_FILE = Path("jarvis_memory.json")
REQUIREMENTS_FILE = Path("requirements.txt")
JARVIS_SCRIPT = Path(__file__).resolve()

load_dotenv(JARVIS_SCRIPT.parent / ".env")

logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s %(levelname)s %(message)s",
    datefmt="%Y-%m-%d %H:%M:%S",
)
log = logging.getLogger("jarvis")

speaking_lock = threading.Lock()
is_speaking = False

# --- Memory Engine -----------------------------------------------------------

def load_memory() -> dict:
    if MEMORY_FILE.exists():
        try:
            return json.loads(MEMORY_FILE.read_text(encoding="utf-8"))
        except Exception as e:
            log.error("Failed to read memory file: %s", e)
    return {
        "user_profile": "User requires brief, formal, and precise technical support.",
        "history": []
    }

def save_memory(memory_data: dict) -> None:
    try:
        MEMORY_FILE.write_text(json.dumps(memory_data, indent=2), encoding="utf-8")
    except Exception as e:
        log.error("Failed to save memory: %s", e)

# --- Speech Engine -----------------------------------------------------------

def speak(text: str) -> None:
    """Synthesizes English spoken audio, prioritizing Microsoft Andrew."""
    if not HAS_TTS:
        return

    def _tts_thread():
        global is_speaking
        with speaking_lock:
            is_speaking = True
            try:
                engine = pyttsx3.init()
                engine.setProperty('rate', 165)
                engine.setProperty('volume', 1.0)
                
                voices = engine.getProperty('voices')
                selected_voice = None
                
                for voice in voices:
                    v_name = voice.name.lower()
                    if 'andrew' in v_name:
                        selected_voice = voice.id
                        break
                
                if not selected_voice:
                    for voice in voices:
                        v_name = voice.name.lower()
                        if any(m in v_name for m in ['david', 'mark', 'male', 'george']):
                            selected_voice = voice.id
                            break
                
                if selected_voice:
                    engine.setProperty('voice', selected_voice)
                elif voices:
                    engine.setProperty('voice', voices[0].id)

                engine.say(text)
                engine.runAndWait()
            except Exception as e:
                log.error("TTS error: %s", e)
            finally:
                time.sleep(0.3)
                is_speaking = False

    threading.Thread(target=_tts_thread, daemon=True).start()

# --- Built-In Core Tools -----------------------------------------------------

def install_package(package_name: str) -> str:
    """Installs target Python library using pip in the local virtual environment."""
    log.info("Attempting installation for package: %s", package_name)
    try:
        cmd = [sys.executable, "-m", "pip", "install", package_name]
        result = subprocess.run(cmd, capture_output=True, text=True, check=True)
        
        # Append to requirements.txt if present
        if REQUIREMENTS_FILE.exists():
            existing = REQUIREMENTS_FILE.read_text(encoding="utf-8")
            if package_name.lower() not in existing.lower():
                REQUIREMENTS_FILE.write_text(existing.strip() + f"\n{package_name}\n", encoding="utf-8")

        return f"Package '{package_name}' installed successfully."
    except subprocess.CalledProcessError as e:
        log.error("Package installation failed: %s", e.stderr)
        return f"Failed to install '{package_name}': {e.stderr}"

def get_weather(location: str = "Tashkent") -> str:
    """Fetches weather details via wttr.in."""
    try:
        city = location.strip().replace(" ", "+")
        url = f"https://wttr.in/{city}?format=%C+%t+%w"
        req = urllib.request.Request(url, headers={'User-Agent': 'Mozilla/5.0'})
        with urllib.request.urlopen(req, timeout=5) as response:
            weather_data = response.read().decode('utf-8').strip()
            return f"Weather in {location.title()}: {weather_data}"
    except Exception as e:
        log.error("Weather fetch failed: %s", e)
        return f"Could not retrieve weather data for {location}."

def execute_python_code(code: str) -> str:
    """Executes target Python code inside local runtime scope."""
    f = io.StringIO()
    local_scope = {}
    try:
        with contextlib.redirect_stdout(f):
            exec(code, globals(), local_scope)
        output = f.getvalue().strip()
        result_val = local_scope.get('result', 'Done')
        return f"Execution successful. Output: {output if output else result_val}"
    except ModuleNotFoundError as e:
        missing_mod = e.name
        log.info("Missing dependency detected: %s. Auto-installing...", missing_mod)
        install_res = install_package(missing_mod)
        return f"Installed missing package '{missing_mod}'. Please retry request."
    except Exception as e:
        return f"Python execution error: {e}"

def open_web_or_app(target: str) -> str:
    """Launches local system applications or web links."""
    t = target.lower().strip()
    sites = {
        "youtube": "https://www.youtube.com",
        "github": "https://www.github.com",
        "google": "https://www.google.com",
    }
    if t in sites:
        webbrowser.open(sites[t])
        return f"Opened {t.title()}."
    
    if t.startswith("http://") or t.startswith("https://"):
        webbrowser.open(t)
        return f"Opened {t}."

    if sys.platform == "win32":
        os.system(f"start {target}")
    else:
        os.system(f"open '{target}'")
    return f"Launched {target}."

AVAILABLE_TOOLS = {
    "install_package": install_package,
    "get_weather": get_weather,
    "execute_python_code": execute_python_code,
    "open_web_or_app": open_web_or_app,
}

# --- Self-Evolution Engine --------------------------------------------------

def extract_python_code(text: str) -> str:
    """Extracts raw python code blocks from model response."""
    match = re.search(r"```python\s*(.*?)\s*```", text, re.DOTALL)
    if match:
        return match.group(1).strip()
    match_generic = re.search(r"```\s*(.*?)\s*```", text, re.DOTALL)
    if match_generic:
        return match_generic.group(1).strip()
    return text.strip()

def run_self_evolution(user_instruction: str) -> str:
    """Handles code modification or system profile updates safely."""
    log.info("Initiating modular self-evolution routine...")

    # Handle system prompt behavior updates via memory directly
    if any(term in user_instruction.lower() for term in ["brief", "formal", "tone", "style", "personality"]):
        memory = load_memory()
        memory["user_profile"] = f"User instruction: {user_instruction}. Ensure responses are extremely concise, direct, brief, and formal."
        save_memory(memory)
        speak("System preferences updated successfully.")
        return "System preferences updated. Communication style modified."

    speak("Initiating code modification sequence.")
    current_code = JARVIS_SCRIPT.read_text(encoding="utf-8")

    evolution_prompt = (
        f"Generate a single standalone Python function to satisfy this request: {user_instruction}\n"
        f"OUTPUT REQUIREMENTS:\n"
        f"- Output ONLY valid Python source code in a ```python ... ``` markdown block.\n"
        f"- Do NOT include conversational sentences or explanations."
    )

    try:
        response = ollama.chat(
            model=OLLAMA_MODEL,
            messages=[{"role": "user", "content": evolution_prompt}],
            options={"num_predict": 2048, "temperature": 0.1}
        )
        
        reply = response.get("message", {}).get("content", "")
        extracted_code = extract_python_code(reply)

        # Detect top-level imports and install missing dependencies prior to AST validation
        parsed_temp = ast.parse(extracted_code)
        for node in ast.walk(parsed_temp):
            if isinstance(node, ast.Import):
                for alias in node.names:
                    try:
                        __import__(alias.name)
                    except ImportError:
                        install_package(alias.name)
            elif isinstance(node, ast.ImportFrom):
                if node.module:
                    try:
                        __import__(node.module)
                    except ImportError:
                        install_package(node.module)

        parsed_ast = ast.parse(extracted_code)
        clean_code = ast.unparse(parsed_ast)

        # Find extracted function definition
        func_name = None
        for node in parsed_ast.body:
            if isinstance(node, ast.FunctionDef):
                func_name = node.name
                break

        if not func_name:
            return "Self-evolution aborted: No top-level Python function found."

        # Inject tool cleanly into AVAILABLE_TOOLS dictionary
        target_str = "AVAILABLE_TOOLS = {"
        if target_str in current_code:
            dict_entry = f'    "{func_name}": {func_name},\n'
            replacement = clean_code + "\n\n" + target_str + "\n" + dict_entry
            updated_code = current_code.replace(target_str, replacement, 1)
        else:
            updated_code = current_code + "\n\n" + clean_code

        # Full AST check on merged source file
        ast.parse(updated_code)

        # Save backup and update script
        backup_path = JARVIS_SCRIPT.with_suffix(".py.bak")
        backup_path.write_text(current_code, encoding="utf-8")
        JARVIS_SCRIPT.write_text(updated_code, encoding="utf-8")

        speak("Upgrade validated and applied. Restarting Jarvis.")
        os.execv(sys.executable, [sys.executable] + sys.argv)
        return "Upgrade successfully applied."

    except SyntaxError as se:
        log.error("Syntax error during AST parse: %s", se)
        return f"Self-upgrade cancelled due to Python syntax error: {se}"
    except Exception as e:
        log.error("Self-evolution error: %s", e)
        return f"Self-upgrade failed: {e}"

# --- Agent Processing Engine ------------------------------------------------

def process_user_query(query: str) -> None:
    memory = load_memory()
    log.info("Processing Query: %s", query)

    upgrade_keywords = ["develop yourself", "upgrade yourself", "modify your code", "update your code"]
    if any(kw in query.lower() for kw in upgrade_keywords):
        result = run_self_evolution(query)
        print(f"\nJarvis: {result}\n")
        speak(result)
        return

    profile_context = memory.get("user_profile", "")
    system_prompt = (
        f"You are Jarvis, a local AI assistant.\n"
        f"BEHAVIORAL DIRECTIVES: {profile_context}\n"
        f"1. Keep responses brief, formal, direct, and strictly in English.\n"
        f"2. Use 'install_package' to download missing Python dependencies when needed."
    )

    messages = [{"role": "system", "content": system_prompt}]
    for msg in memory.get("history", [])[-6:]:
        messages.append(msg)
    messages.append({"role": "user", "content": query})

    try:
        response = ollama.chat(
            model=OLLAMA_MODEL,
            messages=messages,
            tools=list(AVAILABLE_TOOLS.values()),
            options={"num_predict": 2048}
        )

        msg = response.get("message", {})
        tool_calls = msg.get("tool_calls", [])

        if tool_calls:
            messages.append(msg)
            for tool_call in tool_calls:
                func_name = tool_call["function"]["name"]
                func_args = tool_call["function"]["arguments"]

                if func_name in AVAILABLE_TOOLS:
                    log.info("Executing tool: %s with args: %s", func_name, func_args)
                    res = AVAILABLE_TOOLS[func_name](**func_args)
                    
                    messages.append({
                        "role": "tool",
                        "content": str(res),
                        "name": func_name
                    })

            follow_up = ollama.chat(
                model=OLLAMA_MODEL,
                messages=messages
            )
            final_text = follow_up.get("message", {}).get("content", "Task completed.")
        else:
            final_text = msg.get("content", "")

        if final_text:
            print(f"\nJarvis: {final_text}\n")
            speak(final_text)

            memory["history"].append({"role": "user", "content": query})
            memory["history"].append({"role": "assistant", "content": final_text})
            save_memory(memory)

    except Exception as e:
        log.error("Processing failure: %s", e)

# --- Speech Recognition Loop ------------------------------------------------

def listen_and_run() -> None:
    if not HAS_STT:
        log.error("SpeechRecognition unavailable. Please run terminal input mode.")
        return

    recognizer = sr.Recognizer()
    mic = sr.Microphone()

    log.info("Jarvis engine active. Listening for wake word...")

    while True:
        if is_speaking:
            time.sleep(0.1)
            continue

        try:
            with mic as source:
                recognizer.adjust_for_ambient_noise(source, duration=0.3)
                audio = recognizer.listen(source, phrase_time_limit=4)
            
            if is_speaking:
                continue

            text = recognizer.recognize_google(audio, language=STT_LANGUAGE).lower()

            if WAKE_WORD in text:
                speak("At your service, sir.")
                print("\n[Jarvis Active] Listening...")

                while is_speaking:
                    time.sleep(0.05)

                with mic as source:
                    command_audio = recognizer.listen(source, phrase_time_limit=8)
                
                command = recognizer.recognize_google(command_audio, language=STT_LANGUAGE)
                process_user_query(command)

        except sr.UnknownValueError:
            pass
        except Exception as e:
            log.error("Voice listener loop error: %s", e)

if __name__ == "__main__":
    if HAS_STT:
        listen_and_run()
    else:
        speak("Jarvis terminal mode active.")
        while True:
            try:
                user_in = input("You: ")
                if user_in.strip():
                    process_user_query(user_in)
            except (KeyboardInterrupt, EOFError):
                break